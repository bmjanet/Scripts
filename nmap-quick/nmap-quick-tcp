#!/usr/bin/env bash
#
# nmap-quick-tcp - fast, thorough TCP service scan
#
# Two stages: sweep all 65535 ports on every target (fast, no scripts), then
# run -sC -sV against only the open ports found on each host.
#
# Usage: sudo nmap-quick-tcp [-iL <file>] [-oN|-oG|-oX|-oA <file>] <target> [target ...]

set -u

red=$'\e[0;31m'
green=$'\e[0;32m'
yellow=$'\e[0;33m'
blue=$'\e[0;34m'
bold=$'\e[1m'
reset=$'\e[0m'

info() { echo "${blue}[*]${reset} $1"; }
ok()   { echo "${green}[+]${reset} $1"; }
warn() { echo "${yellow}[-]${reset} $1"; }
fail() { echo "${red}[!]${reset} $1" >&2; exit 1; }

usage() {
    echo "Usage: sudo $0 [-iL <file>] [-oN|-oG|-oX|-oA <file>] <target> [target ...]" >&2
    exit 1
}

# Speed settings. Raise min_rate on a fast link; keep max_retries at 2 so nmap
# doesn't miss open ports.
min_rate=3000
timing=4
max_retries=2
host_timeout=30m

# A SYN scan needs raw sockets, so this only works as root.
if [ "$EUID" -ne 0 ]; then
    fail "This script must run as root. Try again with: sudo $0"
fi

# Stage 1 writes its port list here; deleted automatically on exit.
port_file=$(mktemp)
trap 'rm -f "$port_file"' EXIT


# ---------------------------------------------------------------------------
# Parse arguments (nmap-style: targets and flags in any order)
# ---------------------------------------------------------------------------
scan_targets=()   # positional targets and any -iL <file>, in order
output_file=""    # output base name / filespec
output_flag=""    # the output flag chosen (-oN/-oG/-oX/-oA)

while [ $# -gt 0 ]; do
    case "$1" in
        -iL)
            [ -n "${2:-}" ] || usage
            scan_targets+=(-iL "$2"); shift 2 ;;
        -oN|-oG|-oX|-oA)
            [ -n "${2:-}" ] || usage
            output_flag="$1"; output_file="$2"; shift 2 ;;
        -h|--help) usage ;;
        -*) fail "Unknown option: $1" ;;
        *) scan_targets+=("$1"); shift ;;
    esac
done

# Need at least one target: a positional host or -iL <file>.
[ "${#scan_targets[@]}" -gt 0 ] || usage


# ---------------------------------------------------------------------------
# Stage 1: find open ports on every target at once
# ---------------------------------------------------------------------------
echo
echo "${bold}Running scan...${reset}"
echo

info "Stage 1: checking all 65535 ports..."
nmap -sS -Pn -n -p- --open \
     -T"$timing" --min-rate "$min_rate" --max-retries "$max_retries" \
     --host-timeout "$host_timeout" --defeat-rst-ratelimit \
     -oG "$port_file" "${scan_targets[@]}"

host_count=$(grep -c "Ports:" "$port_file")

if [ "$host_count" -eq 0 ]; then
    warn "No open TCP ports found."
    exit 0
fi

echo
ok "Found open ports on $host_count host(s)."
echo


# ---------------------------------------------------------------------------
# Stage 2: scan each host in detail, using only its own open ports
# ---------------------------------------------------------------------------
while read -r line; do

    host=$(echo "$line" | cut -d' ' -f2)

    # Pull this host's open port numbers into nmap's comma list, e.g. "22,80,443".
    open_ports=$(echo "$line" | grep -oE '[0-9]+/open/' | cut -d/ -f1 | sort -un | paste -sd,)

    echo "${bold}=== $host ($open_ports) ===${reset}"

    # Write a file only if one was requested; with multiple hosts, tag the name
    # with the IP so hosts don't overwrite each other.
    output_args=()
    if [ -n "$output_file" ]; then
        if [ "$host_count" -gt 1 ]; then
            output_args=("$output_flag" "${output_file}_${host}")
        else
            output_args=("$output_flag" "$output_file")
        fi
    fi

    nmap -sS -Pn -n -sC -sV -p "$open_ports" \
         -T"$timing" --min-rate 1000 --max-retries "$max_retries" \
         --version-intensity 7 --host-timeout "$host_timeout" \
         "${output_args[@]}" "$host"

    echo

done < <(grep "Ports:" "$port_file")

# Results were written as root, so give them back to whoever ran sudo.
if [ -n "$output_file" ] && [ -n "${SUDO_USER:-}" ]; then
    chown "$SUDO_USER" "$output_file"* 2>/dev/null
fi

ok "Scan complete."
